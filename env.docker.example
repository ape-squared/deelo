# Copy ALL of these into Dokploy → Compose → Environment
# (or save as project-root .env for local `docker compose up`)
#
# Tip: copy values from your local .env + web/.env.local / web/.env.production

# --- Bot ---
DISCORD_TOKEN=
OWNER_IDS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web dashboard (all required for login + dashboard) ---
# Web must have the SAME bot token as the bot service for "installed" detection.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_DISCORD_SERVER_ID=
DISCORD_INVITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_TOKEN=

# --- Optional ---
WEB_PORT=3000
SUPPORT_GUILD_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
OPENAI_API_KEY=
DEFAULT_PREFIX=,

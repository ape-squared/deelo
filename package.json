{
  "name": "deelo-bot",
  "version": "1.0.0",
  "description": "Deelo — Discord's all-in-one community management bot with freemium tiers",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r src/data dist/data",
    "sync:commands": "curl -sL https://bucket.bleed.bot/commands.json -o src/data/commands-catalog.json && node -e \"const d=require('./src/data/commands-catalog.json'); console.log('Synced', d.cogs.reduce((a,c)=>a+c.commands.length,0), 'commands')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "web:env": "node web/scripts/sync-env.mjs",
    "web:env:prod": "node web/scripts/sync-production-env.mjs",
    "web:brand": "node web/scripts/process-brand-assets.mjs",
    "web:admin": "node web/scripts/setup-admin.mjs"
  },
  "keywords": [
    "discord",
    "bot",
    "moderation",
    "music",
    "deelo"
  ],
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "@supabase/supabase-js": "^2.49.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "sharp": "^0.33.5",
    "yt-dlp-wrap": "^2.3.12",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

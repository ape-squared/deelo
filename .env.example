# Discord Bot Token (required)
DISCORD_TOKEN=your_bot_token_here

# Bot owner IDs (comma-separated) for admin commands
OWNER_IDS=123456789012345678

# Supabase (required) — use service_role key, NEVER expose in frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Support server ID for premium subscriptions & status embed
SUPPORT_GUILD_ID=

# Status embed in #status (uses SUPPORT_GUILD_ID + channel named "status" if unset)
# STATUS_GUILD_ID=
# STATUS_CHANNEL_ID=
# STATUS_MESSAGE_ID=
# APP_URL=https://deelo.bot

# Web dashboard (see web/.env.local.example)
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=

# Optional: Last.fm API key for integration
LASTFM_API_KEY=

# Optional: OpenAI API key for ChatGPT (premium)
OPENAI_API_KEY=

# Spotify API (required for music — search, playlists, albums)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Default prefix
DEFAULT_PREFIX=,

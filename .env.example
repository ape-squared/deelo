# Discord Bot Token (required)
DISCORD_TOKEN=your_bot_token_here

# Bot owner IDs (comma-separated) for admin commands
OWNER_IDS=123456789012345678

# Supabase (required) — use service_role key, NEVER expose in frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Official Deelo Discord server (1523831534799425576)
OFFICIAL_GUILD_ID=1523831534799425576
SUPPORT_GUILD_ID=

# Status embed in #status
# STATUS_GUILD_ID=
# STATUS_CHANNEL_ID=1523875524425027837
# STATUS_MESSAGE_ID=
STATUS_INTERNAL_URL=http://web:3000
APP_URL=https://deelo.nikkithewikki.top
PUBLIC_APP_URL=https://deelo.nikkithewikki.top

# Post site /changelog entries to #changelogs (official server only)
CHANGELOG_CHANNEL_ID=1523875521975287869

NEXT_PUBLIC_APP_URL=https://deelo.nikkithewikki.top

# Optional: analytics (Google Analytics G-xxx or Plausible domain)
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: brand domain for footer/legal when deelo.bot goes live
# NEXT_PUBLIC_BRAND_DOMAIN=deelo.bot

# Optional: Last.fm API key for integration
LASTFM_API_KEY=

# AI provider for ChatGPT + TTS (premium)
# Preferred: Puter free OpenAI gateway — create a token at https://puter.com/dashboard
# Docs: https://developer.puter.com/tutorials/free-unlimited-openai-api/
PUTER_AUTH_TOKEN=
# Optional fallback: direct OpenAI key
OPENAI_API_KEY=
# Provider order: auto (Puter then OpenAI) | puter | openai
# AI_PROVIDER=auto
# Optional model overrides (Puter supports gpt-5.4-nano, gpt-4o-mini, etc.)
# OPENAI_CHAT_MODEL=gpt-5.4-nano
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Spotify API (required for music — search, playlists, albums)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Default prefix
DEFAULT_PREFIX=,

# --- Docker / Dokploy (set in Compose Environment — see env.docker.example) ---
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_DISCORD_CLIENT_ID=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=
# DISCORD_BOT_TOKEN=
# WEB_PORT=3000
